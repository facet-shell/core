#!/usr/bin/env bash
# frame-wallpaper – wallpaper backends for the frameshell desktop
#
# The Quickshell wallpaper app (Super+W) is only a front end for this script, and Hyprland
# runs `frame-wallpaper apply` at login. State: ${XDG_STATE_HOME:-~/.local/state}/frameshell/wallpaper.json
#
# Backends ("backend" in the state, asked once by `frame install`):
#   both   Wallpaper Engine scenes and videos from the Steam Workshop (linux-wallpaperengine),
#          plus videos (mpvpaper) from the wallpaper folders; images the shell draws itself
#   mpv    only the wallpaper folders: videos through mpvpaper, images drawn by the shell
#   image  only still images, drawn by the shell (wallpapers/Backdrop.qml), lowest power use
# Wallpaper folders: ~/Pictures/wallpapers (or $WALLPAPER_DIR) and assets/wallpapers in the repo.
#
# Usage:
#   frame-wallpaper list                      JSON list of everything the backend can show
#   frame-wallpaper state                     current state as JSON
#   frame-wallpaper set <path> [screen]       set a wallpaper on one screen ("*" = all) and apply
#   frame-wallpaper option <key> <value>      fps <n> | volume <0-100> | scaling fill|fit | pause true|false
#                                           mature true|false (Workshop items rated Mature in the list)
#   frame-wallpaper backend [both|mpv|image]  show or change the backend ("engine" means both)
#   frame-wallpaper apply                     (re)start the backends from the state
#   frame-wallpaper pause | resume            freeze the backends (the lockscreen does this) and
#                                             let them run again (Wallpaper Engine is restarted
#                                             when it stands still afterwards)
#   frame-wallpaper stop
#
# A switch keeps the old wallpaper until the new one has drawn its first frame, in the
# background: set returns at once, and the next click makes a switch still waiting give way.
# Timing of every switch goes to the log: ${XDG_STATE_HOME:-~/.local/state}/frameshell/wallpaper.log
#
# linux-wallpaperengine flags follow its README.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/frameshell"
STATE="$STATE_DIR/wallpaper.json"
LOG="$STATE_DIR/wallpaper.log"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/frameshell/wallpapers"
WORKSHOP="${WALLPAPER_WORKSHOP:-${XDG_DATA_HOME:-$HOME/.local/share}/Steam/steamapps/workshop/content/431960}"
# Your own wallpapers next to the folder in Pictures (frame keeps them outside every repo)
ASSETS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/frameshell/assets"
FOLDERS=("${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}" "$ASSETS_DIR/wallpapers")
DEFAULT_STATE='{"backend":"both","fps":30,"volume":0,"scaling":"fill","pause":true,"mature":true,"screens":{}}'

die() {
    echo "frame-wallpaper: $*" >&2
    exit 1
}

command -v jq >/dev/null || die "needs jq"

# ── State ─────────────────────────────────────────────────────

state() {
    if [[ -f $STATE ]]; then
        jq --argjson d "$DEFAULT_STATE" '$d + .' "$STATE"
    else
        echo "$DEFAULT_STATE"
    fi
}

# Writes stdin to the state file without leaving half-written files behind
save() {
    mkdir -p "$STATE_DIR"
    local tmp
    tmp="$(mktemp "$STATE_DIR/.wallpaper.XXXXXX")"
    cat >"$tmp"
    mv "$tmp" "$STATE"
}

# Read, change and write under a lock of its own, so two changes at once never drop one
# (a click in the app while the lockscreen resumes, say)
update() {
    mkdir -p "$STATE_DIR"
    (
        if command -v flock >/dev/null; then flock -w 10 9 || true; fi
        next="$(state | jq "$@")"
        save <<<"$next"
    ) 9>>"$STATE_DIR/.wallpaper.lock"
}

# ── Wallpapers ────────────────────────────────────────────────

# scene | video | web | preset | gif for Workshop folders, image | video for files, unknown
# otherwise. linux-wallpaperengine shows scene and video only: "web" is HTML, a "preset" is
# just settings for another (web) wallpaper and has no content of its own, "gif" is a scene
# stored as gifscene.pkg, which the engine cannot read.
kind_of() {
    local path=$1 kind
    if [[ -d $path ]]; then
        if [[ -f $path/project.json ]]; then
            # A broken project.json counts as unknown, not as an empty kind
            kind="$(jq -r '(.type // (if .dependency or .preset then "preset" else "scene" end)) | ascii_downcase' "$path/project.json" 2>/dev/null)" || kind=unknown
            [[ -n $kind ]] || kind=unknown
            if [[ $kind == scene && ! -f $path/scene.pkg && ! -f $path/scene.json ]]; then
                [[ -f $path/gifscene.pkg ]] && kind=gif || kind=unknown
            fi
            echo "$kind"
        else
            echo unknown
        fi
        return
    fi
    case "${path,,}" in
        *.png | *.jpg | *.jpeg | *.webp | *.bmp) echo image ;;
        *.mp4 | *.webm | *.mkv | *.mov | *.gif | *.avi) echo video ;;
        *) echo unknown ;;
    esac
}

# Can the backend show it? Workshop items are folders and need linux-wallpaperengine
allowed() {
    local backend=$1 path=$2 kind=$3
    case "$backend" in
        both) [[ $kind == scene || $kind == video || $kind == image ]] ;;
        mpv) [[ ! -d $path && ($kind == video || $kind == image) ]] ;;
        image) [[ $kind == image ]] ;;
        *) return 1 ;;
    esac
}

# First frame of a video as a cached JPEG; empty without ffmpeg
thumbnail() {
    local file=$1 out
    out="$CACHE/$(printf '%s' "$file" | md5sum | cut -c1-16).jpg"
    if [[ ! -f $out ]] && command -v ffmpeg >/dev/null; then
        mkdir -p "$CACHE"
        ffmpeg -loglevel error -y -ss 1 -i "$file" -frames:v 1 -vf scale=480:-1 "$out" </dev/null || true
    fi
    if [[ -f $out ]]; then echo "$out"; else echo ""; fi
}

cmd_list() {
    local backend dir folder file kind preview name mature
    backend="$(state | jq -r .backend)"
    mature="$(state | jq -r 'if .mature == false then false else true end')"
    {
        if [[ $backend == both && -d $WORKSHOP ]]; then
            for dir in "$WORKSHOP"/*/; do
                dir="${dir%/}"
                [[ -f $dir/project.json ]] || continue
                # Only what the engine can show (see kind_of); the rest would end as a plain color
                kind="$(kind_of "$dir")"
                [[ $kind == scene || $kind == video ]] || continue
                [[ $mature == true ]] || [[ "$(jq -r '.contentrating // ""' "$dir/project.json")" != Mature ]] || continue
                jq -c --arg path "$dir" --arg id "$(basename "$dir")" --arg kind "$kind" '
                    { id: $id, title: (.title // $id), kind: $kind, source: "workshop",
                        tags: ((.tags // []) | map(ascii_downcase)), path: $path,
                        preview: (if .preview then $path + "/" + .preview else "" end) }' \
                    "$dir/project.json" 2>/dev/null || true
            done
        fi
        for folder in "${FOLDERS[@]}"; do
            [[ -d $folder ]] || continue
            while IFS= read -r -d '' file; do
                kind="$(kind_of "$file")"
                allowed "$backend" "$file" "$kind" || continue
                preview="$file"
                [[ $kind == video ]] && preview="$(thumbnail "$file")"
                name="$(basename "$file")"
                jq -nc --arg path "$file" --arg title "${name%.*}" --arg kind "$kind" --arg preview "$preview" \
                    --arg folder "$(basename "$(dirname "$file")")" \
                    '{ id: $path, title: $title, kind: $kind, source: "file", tags: [$folder], path: $path, preview: $preview }'
            done < <(find "$folder" -maxdepth 2 -type f -print0 | sort -z)
        done
    } | jq -s 'unique_by(.path)'
}

# ── Backends ──────────────────────────────────────────────────

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}"
PAUSED_MARK="$RUN_DIR/frame-wallpaper-paused"
# Changes to the backends run one at a time under this lock (see take_ticket)
LOCK="$RUN_DIR/frame-wallpaper.lock"
TICKET="$RUN_DIR/frame-wallpaper.ticket"
# A change that was saved but not shown yet (it gave way to a pause, say); resume shows it
PENDING="$RUN_DIR/frame-wallpaper-pending"
# "<ticket> <outcome>" once a switch has ended; the shell's backdrop keeps the previous
# picture up until then, so a scene that is still loading has something under it
SHOWN="$STATE_DIR/wallpaper.shown"
# How long a new backend may take for its first frame. A big scene needs several seconds
# (all assets, then the shaders) before it maps its layer.
LAYER_WAIT_MS=30000
LOCK_FD=""
TICKET_ID=""

# Timing lines in $LOG, so a slow switch can be told apart from a broken one
log() {
    mkdir -p "$STATE_DIR"
    printf '%s %s\n' "$(date '+%F %T.%3N')" "$*" >>"$LOG"
}

now_ms() {
    local t=${EPOCHREALTIME/[.,]/}
    echo $((t / 1000))
}

# The engines write into the log as long as they run; it is cut in place (not replaced),
# so their open file keeps working
trim_log() {
    [[ -f $LOG ]] || return 0
    (($(stat -c %s "$LOG" 2>/dev/null || echo 0) > 2000000)) || return 0
    local tmp
    tmp="$(mktemp "$STATE_DIR/.wallpaper-log.XXXXXX")"
    tail -n 3000 "$LOG" >"$tmp" && cat "$tmp" >"$LOG"
    rm -f "$tmp"
}

# Every change (and pause, resume, stop) takes a ticket before it waits for the lock, and
# the newest ticket wins: a switch still waiting for its engine gives up as soon as the next
# click comes in, and applies that queued up meanwhile skip straight to the last one.
# Without this a switch could run alongside another (the restart after an unlock and a
# click, the one at login and a click), each taking the other's half-started engine for an
# old one and ending it, which could leave nothing on screen.
take_ticket() {
    mkdir -p "$RUN_DIR"
    TICKET_ID="$$.${EPOCHREALTIME/[.,]/}"
    printf '%s\n' "$TICKET_ID" >"$TICKET.$$"
    mv -f "$TICKET.$$" "$TICKET"
}

superseded() {
    local t=""
    { read -r t <"$TICKET"; } 2>/dev/null || true
    [[ $t != "$TICKET_ID" ]]
}

# Held until this script and the settle step it leaves behind are done. The holder gives
# way within a tenth of a second to a newer ticket, so the wait is short; the timeout is
# only for a holder that hangs.
take_lock() {
    mkdir -p "$RUN_DIR"
    exec {LOCK_FD}>>"$LOCK"
    command -v flock >/dev/null || return 0
    flock -w 60 "$LOCK_FD" || log "lock: still held after 60 s, going on without it"
}

monitors() {
    command -v hyprctl >/dev/null || die "needs a running Hyprland (hyprctl)"
    hyprctl monitors -j | jq -r '.[].name'
}

# Backend processes of this user, by process name. The kernel cuts that name to 15
# characters ("linux-wallpaper"); matching it instead of the command line keeps out
# anything that only names the engine in its arguments (a git clone, an editor, a build).
engine_pids() {
    pgrep -u "$UID" -x linux-wallpaper 2>/dev/null || true
}

backend_pids() {
    { pgrep -u "$UID" -x linux-wallpaper; pgrep -u "$UID" -x mpvpaper; } 2>/dev/null || true
}

# swaybg ran the still pictures before the shell drew them; an old one may still be up
all_backend_pids() {
    { pgrep -u "$UID" -x linux-wallpaper; pgrep -u "$UID" -x mpvpaper; pgrep -u "$UID" -x swaybg; } 2>/dev/null || true
}

# Ends processes for good: a stopped (paused) one only takes SIGTERM once it runs again,
# and one that has not gone after 2 s (an engine stuck waiting for a frame) is killed
end_pids() {
    local pid i alive
    (($#)) || return 0
    for pid in "$@"; do kill -CONT "$pid" 2>/dev/null || true; kill "$pid" 2>/dev/null || true; done
    for ((i = 0; i < 20; i++)); do
        alive=0
        for pid in "$@"; do
            if kill -0 "$pid" 2>/dev/null; then alive=1; break; fi
        done
        ((alive)) || return 0
        sleep 0.1
    done
    for pid in "$@"; do
        if kill -KILL "$pid" 2>/dev/null; then log "killed $pid, it did not end on SIGTERM"; fi
    done
    return 0
}

stop_backends() {
    # shellcheck disable=SC2046
    end_pids $(all_backend_pids)
}

# Backends that were not there before the switch ($1 = " old pids "); under the lock
# nothing else starts any, so these are this switch's own
new_pids() {
    local old=$1 pid out=""
    for pid in $(all_backend_pids); do
        [[ $old == *" $pid "* ]] || out+="$pid "
    done
    echo "$out"
}

# Pids that own a background layer. hyprctl lists a layer only once it is mapped, i.e.
# once its first frame is there.
layer_pids() {
    hyprctl layers -j 2>/dev/null | jq -r '.[].levels["0"][]?.pid' 2>/dev/null || true
}

# Every monitor in $1 has a background layer of one of the pids in $2 (" pid pid ")
layers_up() {
    local monitors=$1 pids=$2 layers monitor pid ok
    [[ -n ${monitors// /} ]] || return 0
    layers="$(hyprctl layers -j 2>/dev/null)" || return 1
    for monitor in $monitors; do
        ok=0
        for pid in $(jq -r --arg m "$monitor" '.[$m].levels["0"][]?.pid' <<<"$layers" 2>/dev/null); do
            if [[ $pids == *" $pid "* ]]; then ok=1; break; fi
        done
        ((ok)) || return 1
    done
    return 0
}

mark_shown() {
    printf '%s %s\n' "$TICKET_ID" "$1" >"$SHOWN.$$"
    mv -f "$SHOWN.$$" "$SHOWN"
}

# Runs a backend in its own session so it outlives this script and the shell. The engine
# repeats one harmless DBus complaint thousands of times, that line stays out of the log.
# Nothing of the caller is passed on: not the lock (an engine holding it would block every
# later change) and not its output (the app would wait for the end of it).
spawn() {
    (
        [[ -z $LOCK_FD ]] || exec {LOCK_FD}>&-
        exec setsid -f sh -c 'exec "$@" 2>&1 | grep --line-buffered -v "DBus error" >>"$0"' "$LOG" "$@" </dev/null >>"$LOG" 2>&1
    )
}


start_on() {
    local monitor=$1 path=$2 kind=$3 settings=$4
    local fps volume scaling pause
    fps="$(jq -r .fps <<<"$settings")"
    volume="$(jq -r .volume <<<"$settings")"
    scaling="$(jq -r .scaling <<<"$settings")"
    pause="$(jq -r .pause <<<"$settings")"

    if [[ -d $path ]]; then
        # The background layer, like mpvpaper and the shell's backdrop: on its default "bottom" layer the
        # wallpaper would take the clicks meant for the canvas desk behind the windows
        local args=(--screen-root "$monitor" --bg "$path" --fps "$fps" --scaling "$scaling" --layer background)
        # Only an active fullscreen window pauses the scene: on Wayland the engine otherwise
        # also stops for fullscreen windows that are hidden (a special workspace, another
        # workspace, the other monitor), and the wallpaper stands still for no visible reason
        if [[ $pause == true ]]; then args+=(--fullscreen-pause-only-active)
        else args+=(--no-fullscreen-pause); fi
        if [[ $volume == 0 ]]; then
            # Muted: no PipeWire streams at all. Quickshell's PipeWire code has crashed when
            # these streams came and went, which took the lockscreen down with it.
            args+=(--silent --no-audio-processing)
            SDL_AUDIODRIVER=dummy spawn linux-wallpaperengine "${args[@]}"
        else
            args+=(--volume "$volume")
            spawn linux-wallpaperengine "${args[@]}"
        fi
    elif [[ $kind == video ]]; then
        local opts flags=()
        opts="loop panscan=$([[ $scaling == fill ]] && echo 1.0 || echo 0.0)"
        if [[ $volume == 0 ]]; then opts+=" no-audio"; else opts+=" volume=$volume"; fi
        # -p pauses the video while windows cover it
        [[ $pause == true ]] && flags+=(-p)
        spawn mpvpaper "${flags[@]}" -o "$opts" "$monitor" "$path"
    else
        # Still pictures: the shell draws them from the state (quickshell wallpapers/Backdrop.qml)
        :
    fi
}

# Frozen while the screen is locked: nothing of it is visible behind the blurred snapshot.
# The marker lets a freshly started shell know there is something to resume.
cmd_pause() {
    local pid
    take_ticket
    take_lock
    for pid in $(backend_pids); do kill -STOP "$pid" 2>/dev/null || true; done
    touch "$PAUSED_MARK"
}

# Lets them run again; mpvpaper just continues. linux-wallpaperengine often does not come
# back from a lock (the compositor stopped asking it for frames and it waits forever), but
# starting it anew costs a whole scene load, so check_engines first looks whether it runs.
cmd_resume() {
    local pid
    take_ticket
    take_lock
    for pid in $(backend_pids); do kill -CONT "$pid" 2>/dev/null || true; done
    rm -f "$PAUSED_MARK"
    if [[ -e $PENDING ]]; then
        log "resume: showing the change that waited for it"
        apply_locked
    elif [[ -n $(engine_pids) ]]; then
        (check_engines) </dev/null >>"$LOG" 2>&1 &
    fi
}

# For a shell that starts while the backends are still paused (the one that paused them is gone)
cmd_resume_if_paused() {
    [[ -e $PAUSED_MARK ]] && cmd_resume
    return 0
}

# utime + stime of a process's main thread, in clock ticks
main_ticks() {
    local pid=$1 s
    s="$(cat "/proc/$pid/task/$pid/stat" 2>/dev/null)" || return 1
    s=${s##*) }
    # shellcheck disable=SC2086
    set -- $s
    echo $((${12} + ${13}))
}

# A stuck engine's main thread waits for a frame and uses no CPU at all; a drawing one uses
# some every second (also while it pauses for a fullscreen window, it polls then). Its other
# threads (DBus, audio) keep going either way, so only the main thread tells. Runs in the
# background, holding the lock.
check_engines() {
    local t0 pid ticks i engines stuck="" pids=()
    local -A before=()
    t0="$(now_ms)"
    engines=" $(engine_pids | tr '\n' ' ') "
    for pid in $(layer_pids); do
        [[ $engines == *" $pid "* ]] || continue
        ticks="$(main_ticks "$pid")" || continue
        pids+=("$pid")
        before[$pid]=$ticks
    done
    if ((${#pids[@]} == 0)); then
        log "resume: no linux-wallpaperengine on screen, starting it anew"
        superseded || apply_locked
        return 0
    fi
    for ((i = 0; i < 20; i++)); do
        superseded && return 0
        sleep 0.1
    done
    for pid in "${pids[@]}"; do
        ticks="$(main_ticks "$pid")" || { stuck+="$pid "; continue; }
        ((ticks > ${before[$pid]})) || stuck+="$pid "
    done
    if [[ -z $stuck ]]; then
        log "resume: linux-wallpaperengine runs on (checked in $(($(now_ms) - t0)) ms)"
        return 0
    fi
    log "resume: linux-wallpaperengine ${stuck% } stands still after the pause, starting it anew"
    superseded || apply_locked
}

# Waits until the new backends draw on every screen they were started on ($2), then ends
# the old ones ($1): both sit on the background layer, the newer on top, so the switch is
# Hyprland's layer fade instead of a gap with a bare background. A new backend that dies or
# never draws is ended and the old wallpaper stays, instead of nothing. Runs in the
# background, holding the lock, so the app does not wait for it; a newer change makes it
# give way at once.
settle() {
    local old=$1 waiting=$2 t0=$3 new="" seen=0 outcome=timeout ms
    while :; do
        new="$(new_pids "$old")"
        ms=$(($(now_ms) - t0))
        if layers_up "$waiting" " $new "; then outcome=up; break; fi
        if superseded; then outcome=superseded; break; fi
        if [[ -n ${new// /} ]]; then
            seen=1
        elif ((seen || ms > 3000)); then
            # Gone, or never came up at all (the binary is missing, say)
            outcome=died
            break
        fi
        ((ms < LAYER_WAIT_MS)) || break
        sleep 0.1
    done
    # shellcheck disable=SC2086
    case $outcome in
        up)
            [[ -z ${waiting// /} ]] || log "switch: new layer up after $ms ms"
            # Hyprland fades the new layer in; the old one goes once it is covered
            sleep 0.6
            end_pids $old
            ;;
        superseded)
            # What is on screen stays until the next change has its own backends up (it
            # takes them for old ones); what still loads would only slow that one down
            log "switch: superseded after $ms ms${new:+, ending the new backends that were still loading (${new% })}"
            end_pids $new
            touch "$PENDING"
            return 0
            ;;
        died)
            log "switch: the new backend ended after $ms ms without a frame (its output is above), the old wallpaper stays"
            ;;
        timeout)
            if [[ -n ${old// /} ]]; then
                log "switch: no new layer after $ms ms, ending the new backends (${new% }), the old wallpaper stays"
                end_pids $new
            else
                log "switch: no new layer after $ms ms, nothing older to keep, so it is left running"
            fi
            ;;
    esac
    mark_shown "$outcome"
    log "switch: done after $(($(now_ms) - t0)) ms ($outcome)"
}

# What a screen gets, for the log
describe() {
    local path=$1 kind=$2 title=""
    if [[ -d $path ]]; then
        title="$(jq -r '.title // ""' "$path/project.json" 2>/dev/null)" || title=""
        echo "$kind ${path##*/}${title:+ \"$title\"}"
    else
        echo "$kind ${path##*/}"
    fi
}

# Starts the backends for the state; the caller holds the lock
apply_locked() {
    local settings backend monitor entry path kind old t0 summary waiting="" shown=()
    t0="$(now_ms)"
    rm -f "$PENDING"
    trim_log
    settings="$(state)"
    backend="$(jq -r .backend <<<"$settings")"
    old=" $(all_backend_pids | tr '\n' ' ') "
    for monitor in $(monitors); do
        # A wallpaper set for this screen wins over the one for all screens
        entry="$(jq -c --arg m "$monitor" '.screens[$m] // .screens["*"] // {}' <<<"$settings")"
        path="$(jq -r '.path // ""' <<<"$entry")"
        kind="$(jq -r '.kind // ""' <<<"$entry")"
        if [[ -n $path && -e $path ]] && allowed "$backend" "$path" "$kind"; then
            start_on "$monitor" "$path" "$kind" "$settings"
            if [[ -d $path || $kind == video ]]; then waiting+="$monitor "; fi
            shown+=("$monitor $(describe "$path" "$kind")")
        else
            # Nothing set, the file is gone, or the backend cannot show it: the shell shows
            # the theme background there (wallpapers/Backdrop.qml)
            shown+=("$monitor plain background")
        fi
    done
    summary="$(printf '%s, ' "${shown[@]}")"
    log "switch: ${summary%, }; old backends:${old% }"
    (settle "$old" "$waiting" "$t0") </dev/null >>"$LOG" 2>&1 &
}

cmd_apply() {
    take_ticket
    take_lock
    if superseded; then
        # The newer one reads the state when it runs, this change included
        touch "$PENDING"
        log "apply: skipped, a newer change follows"
        return 0
    fi
    apply_locked
}

cmd_stop() {
    take_ticket
    take_lock
    rm -f "$PENDING"
    stop_backends
}

cmd_set() {
    local path=${1:-} screen=${2:-*} kind
    [[ -n $path ]] || die "usage: frame-wallpaper set <path> [screen]"
    [[ -e $path ]] || die "not found: $path"
    path="$(readlink -f "$path")"
    kind="$(kind_of "$path")"
    [[ -n $kind && $kind != unknown ]] || die "not a wallpaper: $path"
    if [[ $screen == "*" ]]; then
        update --arg p "$path" --arg k "$kind" '.screens = { "*": { path: $p, kind: $k } }'
    else
        update --arg s "$screen" --arg p "$path" --arg k "$kind" '.screens[$s] = { path: $p, kind: $k }'
    fi
    cmd_apply
}

cmd_option() {
    local key=${1:-} value=${2:-}
    case "$key" in
        fps)
            [[ $value =~ ^[0-9]+$ && $value -ge 1 ]] || die "fps: a number"
            update --argjson v "$value" '.fps = $v' ;;
        volume)
            [[ $value =~ ^[0-9]+$ && $value -le 100 ]] || die "volume: 0 to 100"
            update --argjson v "$value" '.volume = $v' ;;
        scaling)
            [[ $value == fill || $value == fit ]] || die "scaling: fill or fit"
            update --arg v "$value" '.scaling = $v' ;;
        pause)
            [[ $value == true || $value == false ]] || die "pause: true or false"
            update --argjson v "$value" '.pause = $v' ;;
        mature)
            # Workshop items rated "Mature" in the list (false hides them, e.g. for a screen recording)
            [[ $value == true || $value == false ]] || die "mature: true or false"
            update --argjson v "$value" '.mature = $v'
            return 0 ;;
        *) die "options: fps, volume, scaling, pause, mature" ;;
    esac
    cmd_apply
}

cmd_backend() {
    if [[ $# -eq 0 ]]; then
        state | jq -r .backend
        return
    fi
    local backend=$1
    [[ $backend == engine ]] && backend=both
    case "$backend" in
        both | mpv | image) ;;
        *) die "backend: both (engine), mpv or image" ;;
    esac
    update --arg v "$backend" '.backend = $v'
    # Only restart when a desktop is running (frame install sets it before the first login)
    if command -v hyprctl >/dev/null && hyprctl monitors >/dev/null 2>&1; then
        cmd_apply
    fi
}

case "${1:-}" in
    list) cmd_list ;;
    state) state ;;
    set) shift; cmd_set "$@" ;;
    option) shift; cmd_option "$@" ;;
    backend) shift; cmd_backend "$@" ;;
    apply) cmd_apply ;;
    pause) cmd_pause ;;
    resume) cmd_resume ;;
    resume-if-paused) cmd_resume_if_paused ;;
    stop) cmd_stop ;;
    *) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
esac
